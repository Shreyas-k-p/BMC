# BMC LIVE: Supabase Realtime Environment Configuration
# If configured, the app persists all sessions, participants, groups, scores, and comments
# directly to your PostgreSQL database with Supabase Realtime synchronization.
# If left blank, the app will run with full high-performance local Realtime broadcast & storage.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
